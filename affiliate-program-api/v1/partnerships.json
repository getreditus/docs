{
  "openapi": "3.1.0",
  "info": {
    "title": "Reditus API - Partnerships",
    "description": "API specification for managing partnerships in Reditus.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.getreditus.com/api"
    }
  ],
  "paths": {
    "/v1/partnerships": {
      "get": {
        "summary": "List Partnerships",
        "description": "Retrieve a paginated list of partnerships.",
        "parameters": [
          {
            "name": "state_eq",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Filter by state (pending, accepted, declined)"
            }
          },
          {
            "name": "created_at_lt",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Created before (e.g. \"2022-12-24%2012:47:45%20+0200\")"
            }
          },
          {
            "name": "created_at_gt",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Created after (e.g. \"2021-11-23%2012:47:45%20+0200\")"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "description": "Page number"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 50,
              "description": "Records to be displayed per page"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnershipListResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/partnerships/{id}": {
      "get": {
        "summary": "Get Partnership",
        "description": "Show data for a partnership.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Partnership id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnershipResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/partnerships/{id}/accept": {
      "post": {
        "summary": "Accept Partnership",
        "description": "Accepts a `pending` affiliate request, so the partner joins your program and can start referring. This triggers the same notifications as accepting the request in the Reditus dashboard: the partner receives your welcome email (or your custom partnership-started emails, if enabled) and your configured Slack, HubSpot and webhook integrations are notified. Only `pending` partnerships can be accepted; declined or terminated ones cannot be accepted through the API.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Reditus id of the partnership"
          }
        ],
        "responses": {
          "200": {
            "description": "Partnership was accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnershipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Partnership not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseNotFound"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable - Partnership cannot be accepted from its current state (it is already accepted, declined or terminated)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseUnprocessable"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/partnerships/{id}/terminate": {
      "post": {
        "summary": "Terminate Partnership",
        "description": "Ends a partnership for good. The partner is removed from your program, loses access to their referral link and is notified by email. A `termination_reason` is required; it is stored on the partnership and returned in the `termination_reason` attribute. Any `pending`, `accepted` or `declined` partnership can be terminated. Termination cannot be undone through the API, so use the decline flow in the dashboard if you only want to turn down a request.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Reditus id of the partnership"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TerminatePartnershipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Partnership was terminated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnershipResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - No termination_reason provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBadRequest"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Partnership not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseNotFound"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable - Partnership is already terminated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseUnprocessable"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PartnershipListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Partnership"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "pagination": {
                "type": "object",
                "properties": {
                  "page": {
                    "type": "integer"
                  },
                  "per_page": {
                    "type": "integer"
                  },
                  "has_more": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      },
      "PartnershipResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Partnership"
          }
        }
      },
      "Partnership": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "attributes": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "description": "Partnership state: pending, accepted, declined or terminated"
              },
              "termination_reason": {
                "type": "string",
                "description": "Reason the partnership was terminated. Only present when state is terminated"
              },
              "competitor_slugs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "created_by": {
                "type": "string"
              },
              "state_set_at": {
                "type": "integer"
              },
              "created_at": {
                "type": "integer"
              },
              "updated_at": {
                "type": "integer"
              },
              "referral_link": {
                "type": "string"
              }
            }
          },
          "relationships": {
            "type": "object",
            "properties": {
              "partner": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "TerminatePartnershipRequest": {
        "type": "object",
        "required": ["termination_reason"],
        "properties": {
          "termination_reason": {
            "type": "string",
            "description": "**required** - Free-text reason for ending the partnership. Kept on the partnership for your team's records and returned in the `termination_reason` attribute.",
            "example": "Partner violated the program terms"
          }
        }
      },
      "ErrorResponseBadRequest": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "example": "Bad Request"
                },
                "details": {
                  "type": "string",
                  "example": "termination_reason is required"
                }
              }
            }
          }
        }
      },
      "ErrorResponseNotFound": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "example": "Not Found"
                },
                "details": {
                  "type": "string",
                  "example": "Partnership not found"
                }
              }
            }
          }
        }
      },
      "ErrorResponseUnprocessable": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "example": "Unprocessable entity"
                },
                "details": {
                  "type": "string",
                  "example": "Partnership in state 'accepted' cannot be accepted"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
