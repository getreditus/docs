{
  "openapi": "3.1.0",
  "info": {
    "title": "Reditus API - Commissions",
    "description": "API specification for managing commissions in Reditus affiliate programs.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.getreditus.com/api"
    }
  ],
  "paths": {
    "/v1/commissions": {
      "get": {
        "summary": "List Commissions",
        "description": "Retrieve a paginated list of commissions",
        "parameters": [
          {
            "name": "state_eq",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Filter by state (pending, rejected, paid)"
            }
          },
          {
            "name": "partner_id_eq",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Filter by partner ID"
            }
          },
          {
            "name": "created_at_lt",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Created before (e.g. \"2022-12-24%2012:47:45%20+0200\")"
            }
          },
          {
            "name": "created_at_gt",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Created after (e.g. \"2021-11-23%2012:47:45%20+0200\")"
            }
          },
          {
            "name": "state_set_at_lt",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "State set at before (e.g. \"2022-12-24%2012:47:45%20+0200\")"
            }
          },
          {
            "name": "state_set_at_gt",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "State set at after (e.g. \"2021-12-24%2012:47:45%20+0200\")"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "description": "Page number" }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 50,
              "description": "Records to be displayed per page"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommissionListResponse"
                }
              }
            }
          }
        },
        "security": [{ "BearerAuth": [] }]
      },
      "post": {
        "summary": "Create One-off Commission",
        "description": "Creates a one-off commission for a partner that is not tied to a referral or a campaign. Use this for bonuses, manual corrections or any commission you want to award outside of the automatic tracking. The `amount` is in cents and in your account's preferred currency; it is converted to the partner's preferred currency for payout. The partner must have an accepted partnership with your program. The commission is created as `pending` unless you pass `state: paid`, in which case it is recorded as already paid out. The optional `one_off_reason` is shown to your team in the Reditus dashboard and returned in the `one_off_reason` attribute.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCommissionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Commission was created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommissionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Missing or invalid partner_id, amount or state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBadRequest"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Partner not found or partnership is not accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseNotFound"
                }
              }
            }
          }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/v1/commissions/{id}": {
      "get": {
        "summary": "Get Commission",
        "description": "Show data for a commission.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommissionResponse"
                }
              }
            }
          }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/v1/commissions/{id}/reject": {
      "post": {
        "summary": "Reject Commission",
        "description": "Rejects a `pending` commission so it will not be paid out to the affiliate. Use this when a commission should not have been earned, for example because the referral turned out to be fraudulent or the purchase was cancelled. You can optionally pass a `reject_reason`, which is stored on the commission and returned in the `reject_reason` attribute while the commission is rejected. Only `pending` commissions can be rejected; `paid` commissions cannot be reverted through the API. A rejected commission can be moved back to `pending` with the unreject endpoint.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Reditus id of the commission"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectCommissionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Commission was rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommissionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Commission not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseNotFound"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable - Commission cannot be rejected from its current state (it is already rejected, or has been paid)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseUnprocessable"
                }
              }
            }
          }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/v1/commissions/{id}/unreject": {
      "post": {
        "summary": "Unreject Commission",
        "description": "Moves a `rejected` commission back to `pending`, so it becomes payable to the affiliate again. Use this to undo a rejection made by mistake. The previously stored `reject_reason` is no longer returned once the commission is pending. Only `rejected` commissions can be unrejected.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Reditus id of the commission"
          }
        ],
        "responses": {
          "200": {
            "description": "Commission was moved back to pending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommissionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Commission not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseNotFound"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable - Commission cannot be unrejected from its current state (it is pending or has been paid)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseUnprocessable"
                }
              }
            }
          }
        },
        "security": [{ "BearerAuth": [] }]
      }
    }
  },
  "components": {
    "schemas": {
      "CommissionListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Commission" }
          },
          "meta": {
            "type": "object",
            "properties": {
              "pagination": {
                "type": "object",
                "properties": {
                  "page": { "type": "integer" },
                  "per_page": { "type": "integer" },
                  "has_more": { "type": "boolean" }
                }
              }
            }
          }
        }
      },
      "CommissionResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/Commission" }
        }
      },
      "Commission": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "attributes": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "description": "Commission state: pending, rejected or paid"
              },
              "amount": {
                "type": "integer",
                "description": "Commission amount, in cents"
              },
              "currency": {
                "type": "string",
                "description": "Three-letter ISO currency code of the amount"
              },
              "partner_id": {
                "type": "string",
                "description": "ID of the partner the commission belongs to"
              },
              "referral_id": {
                "type": "string",
                "description": "ID of the referral the commission originates from, if any"
              },
              "reject_reason": {
                "type": "string",
                "description": "Reason the commission was rejected. Only present when state is rejected"
              },
              "one_off_reason": {
                "type": "string",
                "description": "Reason given when the commission was created as a one-off. Only present for one-off commissions created with a reason"
              },
              "state_set_at": { "type": "integer" },
              "paid_at": {
                "type": "integer",
                "description": "Timestamp the commission was paid at, if paid"
              },
              "created_at": { "type": "integer" },
              "updated_at": { "type": "integer" }
            }
          }
        }
      },
      "CreateCommissionRequest": {
        "type": "object",
        "required": ["partner_id", "amount"],
        "properties": {
          "partner_id": {
            "type": "string",
            "description": "**required** - Reditus id of the partner receiving the commission. The partner must have an accepted partnership with your program.",
            "example": "5f4b1c2e-9b7a-4e3d-8c1a-2b3c4d5e6f70"
          },
          "amount": {
            "type": "integer",
            "description": "**required** - Commission amount in cents, in your account's preferred currency (e.g. 1400 = $14.00). Must be a positive integer.",
            "example": 1400
          },
          "state": {
            "type": "string",
            "enum": ["pending", "paid"],
            "default": "pending",
            "description": "State to create the commission in. Use `paid` when the commission was already paid out to the partner outside of Reditus."
          },
          "one_off_reason": {
            "type": "string",
            "description": "Optional free-text reason for the one-off commission, e.g. a bonus or a manual correction.",
            "example": "Q3 bonus"
          }
        }
      },
      "ErrorResponseBadRequest": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "example": "Bad Request" },
                "details": {
                  "type": "string",
                  "example": "Validation failed: Amount must be greater than 0"
                }
              }
            }
          }
        }
      },
      "RejectCommissionRequest": {
        "type": "object",
        "properties": {
          "reject_reason": {
            "type": "string",
            "description": "Optional free-text reason for rejecting the commission. Shown to your team in the Reditus dashboard and returned in the commission's `reject_reason` attribute.",
            "example": "Fraudulent referral"
          }
        }
      },
      "ErrorResponseNotFound": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "example": "Not Found" },
                "details": {
                  "type": "string",
                  "example": "Commission not found, or partner not found or partnership is not accepted"
                }
              }
            }
          }
        }
      },
      "ErrorResponseUnprocessable": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "example": "Unprocessable entity" },
                "details": {
                  "type": "string",
                  "example": "Commission in state 'paid' cannot be rejected"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
